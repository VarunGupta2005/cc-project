# =============================================================
# RESCUEGRID SERVER ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure secrets appropriately.
# Never commit real production secrets to version control.
# =============================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connections
DATABASE_URL=postgresql://postgres:password@localhost:5432/rescuegrid
REDIS_URL=redis://localhost:6379

# Cryptographic & Authentication Secrets
# Generate strong, random 256-bit keys for production (e.g. using openssl rand -hex 32)
JWT_SECRET=replace_with_strong_jwt_secret_in_production
HMAC_SECRET=replace_with_strong_hmac_secret_in_production
